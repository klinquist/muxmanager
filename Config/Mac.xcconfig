#include "Base.xcconfig"
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY =
INFOPLIST_FILE = Config/Mac-Info.plist
CODE_SIGN_ENTITLEMENTS = Config/Mac.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = MacAppIcon
ENABLE_HARDENED_RUNTIME = YES
// A local terminal must launch the user's shell and access its tmux socket/files.
ENABLE_APP_SANDBOX = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
